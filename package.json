{
  "name": "strapi-field-kit",
  "private": true,
  "description": "Custom fields that the Strapi 5 Content-Type Builder is missing",
  "license": "MIT",
  "author": {
    "name": "Tung Le",
    "email": "nhattung1511@gmail.com",
    "url": "https://tungln.is-a.dev"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
    "verify": "pnpm --filter \"./packages/*\" -r verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "playground": "pnpm --filter playground develop"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
