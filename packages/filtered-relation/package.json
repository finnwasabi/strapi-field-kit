{
  "name": "@tunghtml/strapi-plugin-filtered-relation",
  "version": "1.1.7",
  "description": "A Strapi custom field plugin for displaying filtered relations with dynamic placeholder support and status change capability",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "custom-field",
    "relation",
    "filter",
    "status"
  ],
  "homepage": "https://github.com/finnwasabi/strapi-field-kit/tree/main/packages/filtered-relation#readme",
  "bugs": {
    "url": "https://github.com/finnwasabi/strapi-field-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finnwasabi/strapi-field-kit.git",
    "directory": "packages/filtered-relation"
  },
  "license": "MIT",
  "author": {
    "name": "Tung Le",
    "email": "nhattung1511@gmail.com",
    "url": "https://tungln.is-a.dev"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "typecheck": "tsc -p admin/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.59.0",
    "@strapi/typescript-utils": "^5.59.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.19",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "filtered-relation",
    "displayName": "Filtered Relation",
    "description": "Relation field with filtering capability, dynamic placeholders, and status change"
  }
}
